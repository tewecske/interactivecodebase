classDiagram
  class notes_Service {
    -Repository repo
    -Mailer mail
    +Create(ctx context.Context, ownerID int64, title string, body string) (Note, error)
    +Get(ctx context.Context, id int64) (Note, error)
    +List(ctx context.Context, ownerID int64) ([]Note, error)
    +Share(ctx context.Context, id int64, to string) error
  }
  class notes_Note {
    +int64 ID
    +int64 OwnerID
    +string Title
    +string Body
    +time.Time CreatedAt
  }
  class notes_Repository {
    <<interface>>
    +Create(ctx context.Context, note Note) (Note, error)
    +Get(ctx context.Context, id int64) (Note, error)
    +ListByOwner(ctx context.Context, ownerID int64) ([]Note, error)
  }
  class notes_Mailer {
    <<interface>>
    +Send(ctx context.Context, to string, subject string, body string) error
  }
  class postgres_NoteRepository {
    -*sql.DB db
    +Create(ctx context.Context, note notes.Note) (notes.Note, error)
    +Get(ctx context.Context, id int64) (notes.Note, error)
    +ListByOwner(ctx context.Context, ownerID int64) ([]notes.Note, error)
  }
  class mail_SMTPMailer {
    -string addr
    -string from
    +Send(_ context.Context, to string, subject string, body string) error
  }
  notes_Service --> notes_Repository
  notes_Service --> notes_Mailer
  postgres_NoteRepository ..|> notes_Repository
  mail_SMTPMailer ..|> notes_Mailer
  click notes_Note call icbClick()
  click notes_Mailer call icbClick()
  click notes_Service call icbClick()
  click mail_SMTPMailer call icbClick()
  click notes_Repository call icbClick()
  click postgres_NoteRepository call icbClick()
